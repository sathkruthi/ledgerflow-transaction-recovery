{
  "uid": "ledgerflow",
  "title": "LedgerFlow transaction recovery",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Acceptance per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerflow-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(ledgerflow_acceptance_total[1m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "title": "Durable pending work",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerflow-prometheus"
      },
      "targets": [
        {
          "expr": "ledgerflow_backlog{kind=~\"outbox_pending|delivery_pending|transfers_accepted\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 3,
      "title": "Dead-letter deliveries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerflow-prometheus"
      },
      "targets": [
        {
          "expr": "ledgerflow_backlog{kind=\"delivery_dead\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "title": "API acceptance p95 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerflow-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ledgerflow_acceptance_seconds_bucket[1m])))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "title": "API resident memory bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerflow-prometheus"
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "title": "API goroutines",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerflow-prometheus"
      },
      "targets": [
        {
          "expr": "go_goroutines",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    }
  ]
}
